# Database
MONGODB_URI=mongodb://localhost:27017/ezyschool
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/ezyschool

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Server
NODE_ENV=development
PORT=5000

# Cloudinary (Free Plan)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase (Free Tier)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id

# HuggingFace (Free)
HUGGINGFACE_API_KEY=your_huggingface_api_key

# Admin Credentials
ADMIN_EMAIL=admin@ezyschool.com
ADMIN_PASSWORD=admin123

# Frontend URLs
FRONTEND_STUDENT_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:3001

# WhatsApp (Optional - yowsup or whatsapp-web.js)
WHATSAPP_NUMBER=your_whatsapp_number
WHATSAPP_PASSWORD=base64_encoded_password
